# Copy to .env and fill in real values. Never commit .env.

DATABASE_URL=postgresql://user:password@host:5432/postgres

TABOOLA_CLIENT_ID=your_client_id
TABOOLA_CLIENT_SECRET=your_client_secret
TABOOLA_ACCOUNT_ID=your_network_account_id
TABOOLA_API_BASE=https://backstage.taboola.com/backstage/api/1.0

CODEFUEL_CLIENT_ID=your_codefuel_client_id
CODEFUEL_CLIENT_SECRET=your_codefuel_client_secret
CODEFUEL_API_BASE=https://search-api.perion.com/api

IMAGE_ADVANTAGE_EMAIL=your_ia_email
IMAGE_ADVANTAGE_PASSWORD=your_ia_password
IMAGE_ADVANTAGE_ACCOUNT_ID=398
IMAGE_ADVANTAGE_API_BASE=https://api.vpptechia.com/v1

PORT=4000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000
ENABLE_CRON=false

# API authentication: every /api call needs a Supabase session token from THIS
# deployment's Auth project. The API verifies it against SUPABASE_URL and then
# requires an app_users row (invited user). Production refuses to start without
# these; API_AUTH_DISABLED=true is for local development only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_or_publishable_key
API_AUTH_DISABLED=false

# Local runs for another tenant: ENV_FILE=.env.joe npm run sync:once -- <job>
# (only that file is read, so the other tenant's credentials are never inherited)

# DDC (Domain Development Corp) — revenue partner on Outbrain SBH_ssm_09
DDC_REPORTING_URL=https://<your-host>.ddcxlayer.com
DDC_USERNAME=
DDC_PASSWORD=
DDC_HOURLY_API_BASE=https://rdp.ddc.com
DDC_HOURLY_AUTH_CODE=

# Tenancy — one repo deployed once per client, each with its own database.
# The partner credentials above are shared and return EVERY account, so each
# deployment says which are its own (regex on account/marketer name, case-insensitive).
#   Nadia: ENABLED_SOURCES=taboola,outbrain,codefuel,image_advantage,ddc
#          TENANT_ACCOUNT_EXCLUDE=^SBH_rev_|Revlogic Media
#   Joe:   ENABLED_SOURCES=taboola,outbrain,image_advantage
#          TENANT_ACCOUNT_INCLUDE=^SBH_rev_|Revlogic Media
#          TABOOLA_ACCOUNT_ID=revlogicmedia4945-network
#          TENANT_IA_AFFILIATE_EXCLUDE=^ssm\.
#   (Nadia also sets TENANT_IA_AFFILIATE_INCLUDE=^ssm\. — all her IA affiliates use that prefix)
ENABLED_SOURCES=taboola,outbrain,codefuel,image_advantage,ddc
TENANT_ACCOUNT_INCLUDE=
TENANT_ACCOUNT_EXCLUDE=
TENANT_IA_AFFILIATE_INCLUDE=
TENANT_IA_AFFILIATE_EXCLUDE=

# Client report delivery (Resend). The from-domain must be VERIFIED on the Resend
# account, otherwise delivery is restricted to the account owner's own address.
RESEND_API_KEY=
REPORT_EMAIL_FROM=Seven Sphere Reports <nadia@revlogicmedia.com>
REPORT_EMAIL_TO=

