# Copy to .env and fill in real values. Never commit .env.

DATABASE_URL=postgresql://user:password@host:5432/postgres

TABOOLA_CLIENT_ID=your_client_id
TABOOLA_CLIENT_SECRET=your_client_secret
TABOOLA_ACCOUNT_ID=your_network_account_id
TABOOLA_API_BASE=https://backstage.taboola.com/backstage/api/1.0

CODEFUEL_CLIENT_ID=your_codefuel_client_id
CODEFUEL_CLIENT_SECRET=your_codefuel_client_secret
CODEFUEL_API_BASE=https://search-api.perion.com/api

IMAGE_ADVANTAGE_EMAIL=your_ia_email
IMAGE_ADVANTAGE_PASSWORD=your_ia_password
IMAGE_ADVANTAGE_ACCOUNT_ID=398
IMAGE_ADVANTAGE_API_BASE=https://api.vpptechia.com/v1

PORT=4000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000
ENABLE_CRON=false

# DDC (Domain Development Corp) — revenue partner on Outbrain SBH_ssm_09
DDC_REPORTING_URL=https://<your-host>.ddcxlayer.com
DDC_USERNAME=
DDC_PASSWORD=
DDC_HOURLY_API_BASE=https://rdp.ddc.com
DDC_HOURLY_AUTH_CODE=

# Client report delivery (Resend). The from-domain must be VERIFIED on the Resend
# account, otherwise delivery is restricted to the account owner's own address.
RESEND_API_KEY=
REPORT_EMAIL_FROM=Seven Sphere Reports <nadia@revlogicmedia.com>
REPORT_EMAIL_TO=

