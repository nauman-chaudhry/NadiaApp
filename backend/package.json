{
  "name": "nadia-dashboard-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API + sync workers for the Nadia Solutions advertising dashboard",
  "scripts": {
    "dev:api": "tsx watch src/api/server.ts",
    "dev:worker": "tsx watch src/workers/cron.ts",
    "build": "tsc -p tsconfig.json",
    "start:api": "node dist/api/server.js",
    "start:worker": "node dist/workers/cron.js",
    "sync:once": "tsx src/workers/run-once.ts",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:prod": "node dist/db/migrate.js"
  },
  "dependencies": {
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/node": "^20.12.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.0",
    "axios": "^1.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "node-cron": "^3.0.3",
    "pg": "^8.12.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "typescript": "^5.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "tsx": "^4.22.5"
  }
}
